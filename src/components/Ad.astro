---
/**
 * AdSense の広告枠。
 *
 * 方針:
 * - 枠の高さを CSS であらかじめ確保し、読み込み時にレイアウトがずれない（CLS対策）
 * - 「広告」と明示する。AdSense のポリシーで、広告とコンテンツの混同は禁止されている
 * - ナビゲーションやボタンの直下には置かない（誤クリック誘発とみなされる）
 * - slot が未設定のときは何も描画しない（審査前でもレイアウトが壊れない）
 *
 * slot ID は AdSense の管理画面で広告ユニットを作ると発行される。
 * src/lib/ads.js に控えて、そこから渡す。
 */
const { slot, layout = 'in-article', label = true } = Astro.props;
const CLIENT = 'ca-pub-5761092657360295';
---
{slot && (
  <aside class:list={['ad', `ad-${layout}`]} aria-label="広告">
    {label && <p class="ad-label">広告</p>}
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={CLIENT}
      data-ad-slot={slot}
      data-ad-format={layout === 'in-article' ? 'fluid' : 'auto'}
      data-ad-layout={layout === 'in-article' ? 'in-article' : undefined}
      data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
)}
