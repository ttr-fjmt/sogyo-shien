---
import Base from '../../layouts/Base.astro';
import { yen } from '../../lib/fmt.js';
import { municipalities, published, stats } from '../../lib/catalog.js';

export async function getStaticPaths() {
  return ['registration-tax', 'jizokuka-sogyo', 'sogyo-hosho', 'jfc-kinri'].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

const SEIDO = {
  'registration-tax': {
    title: '登録免許税の半額',
    h1: ['会社設立の登録免許税を', '半額にする'],
    lead: '株式会社なら15万円が7万5千円に、合同会社なら6万円が3万円に。市区町村が交付する「特定創業支援等事業による支援を受けたことの証明書」を、登記申請時に法務局へ提出すると適用されます。',
    amount: '7万5千円',
    body: [
      { h: '軽減される額', p: '資本金の0.7%の登録免許税が0.35%に軽減されます。最低税額のケースでは、株式会社が15万円→7万5千円、合同会社が6万円→3万円です。資本金が大きい場合は0.35%分がそのまま軽減額になります。' },
      { h: '受けるための条件', p: '創業予定地の市区町村が認定を受けた「特定創業支援等事業」を、原則4回以上・1か月以上にわたって受講し、経営・財務・人材育成・販路開拓の4分野の知識を得ること。受講後に市区町村へ申請して証明書の交付を受けます。' },
      { h: '最も注意すべき点', p: '証明書は登記申請のときに法務局へ提出する必要があります。会社を設立してしまってから申請しても軽減は受けられません。設立登記の前に、受講と証明書の取得を済ませておく必要があります。' },
      { h: '対象にならないケース', p: '2社目以降の創業、事業承継による2代目代表、会社設立後の組織変更は対象外です。法人の場合は、会社法上の発起人かつ代表者となる個人本人が受講している必要があり、役員や社員が受講しても適用されません。' },
      { h: '証明書を取った市区町村以外で設立する場合', p: '登録免許税の軽減は、証明書を交付した市区町村内で会社を設立する場合に限られます。他市で設立する場合は、その市区町村が交付した証明書が必要です。' },
    ],
    note: '合名会社・合資会社の取り扱いについては、自治体のページ間で記載が食い違っています。検討している場合は、設立予定地の市区町村または法務局に必ず確認してください。',
  },
  'jizokuka-sogyo': {
    title: '持続化補助金〈創業型〉',
    h1: ['小規模事業者持続化補助金の', '補助上限を250万円に上げる'],
    lead: '特定創業支援等事業の支援を過去3か年以内に受け、かつ過去3か年以内に開業した事業者は、小規模事業者持続化補助金の〈創業型〉に申請できます。',
    amount: '最大250万円',
    body: [
      { h: '通常枠との違い', p: '通常枠の補助上限に対し、〈創業型〉では補助上限額が引き上げられます。自治体の案内では上限200万円と250万円の両方の記載が見られるため、申請時点の公募要領で必ず確認してください。' },
      { h: '受けるための条件', p: '①特定創業支援等事業による支援を過去3か年の間に受けていること、②過去3か年の間に開業していること。「過去3か年」は各公募の締切時から起算します。' },
      { h: '他の優遇と違う点', p: '登録免許税の軽減と異なり、支援を受けた市区町村以外の地域で創業した場合も対象になります。また、証明書が有効期限切れであっても、申請時の必要書類として認められます。' },
      { h: '名義の要件', p: '法人の場合は法人の代表者が、個人事業主の場合は本人が、特定創業支援等事業による支援を受けた者である必要があります。家族専従者や後継予定者が受講した場合は対象外です。' },
    ],
    note: '証明書は「特定創業支援等事業により支援を受けたこと」の証明であり、補助対象者であることの証明ではありません。補助金の採否は別途審査されます。',
  },
  'sogyo-hosho': {
    title: '創業関連保証の特例',
    h1: ['創業関連保証を', '事業開始の6か月前から使う'],
    lead: '無担保・第三者保証人なしの創業関連保証を、通常より早い時期から利用できるようになります。個人事業主は1か月前から、法人は2か月前からのところが、いずれも6か月前からになります。',
    amount: '6か月前から',
    body: [
      { h: '何が変わるか', p: '創業関連保証枠を利用した融資の申し込みが、事業開始の6か月前から可能になります。通常は個人事業主で1か月前、法人で2か月前からです。開業準備の資金を早い段階で確保できるようになります。' },
      { h: '手続き', p: '信用保証協会または金融機関に証明書（写し可）を提出し、別途審査を受けます。証明書があれば必ず保証が受けられるわけではありません。' },
      { h: '他市で創業する場合', p: '登録免許税の軽減とは異なり、証明書を交付した市区町村以外で創業する場合でも、創業関連保証の特例は活用できます。' },
    ],
    note: null,
  },
  'jfc-kinri': {
    title: '日本政策金融公庫の金利引き下げ',
    h1: ['新規開業・スタートアップ支援資金の', '貸付利率を下げる'],
    lead: '日本政策金融公庫の「新規開業・スタートアップ支援資金」について、貸付利率の引き下げ対象になります。',
    amount: '貸付利率の引き下げ',
    body: [
      { h: '対象となる資金', p: '日本政策金融公庫の「新規開業・スタートアップ支援資金」が対象です。沖縄県内での創業の場合は、日本政策金融公庫ではなく沖縄振興開発金融公庫の「新規開業支援資金」が窓口になります。' },
      { h: '手続き', p: '別途審査を受ける必要があります。引き下げ幅や適用条件は公庫にご確認ください。' },
      { h: '他市で創業する場合', p: '自治体によって扱いが異なります。松本市のように「本市が交付する証明書をもって他の市区町村で創業する場合は、金利引き下げを受けることができません」と明記している例があります。証明書を取得した市区町村の案内を確認してください。' },
    ],
    note: '引き下げ幅は金融情勢により変動します。具体的な利率は日本政策金融公庫（沖縄県は沖縄振興開発金融公庫）にお問い合わせください。',
  },
};

const s = SEIDO[slug];
const description = `${s.lead.slice(0, 100)}`;
// この制度に言及している自治体を、実データから数える
const citing = municipalities.filter((m) =>
  m.otherBenefits?.some((b) => b.title.includes(s.title.slice(0, 4))) ||
  (slug === 'registration-tax')
);
// 掲載データのうち最も新しい確認日を出す（直書きすると更新し忘れる）
const lastVerified = municipalities.map((m) => m.lastVerified).sort().at(-1);
---

<Base title={`${s.title}｜特定創業支援等事業で受けられる優遇`} description={description}>
  <p class="eyebrow">制度解説 <span class="sep"></span> 特定創業支援等事業</p>
  <h1><span class="nb">{s.h1[0]}</span><span class="nb">{s.h1[1]}</span></h1>
  <p class="standfirst">{s.lead}</p>
  <p class="stamp"><span>最終確認 <b>{lastVerified}</b></span><span>{municipalities.length}自治体の公式ページを確認</span></p>

  {slug === 'registration-tax' && (
    <div class="ledger">
      <div class="ledger-cell">
        <p class="kind">株式会社を設立する場合</p>
        <p class="amounts">
          <span class="was">{yen(150000)}</span><span class="arrow">→</span><span class="now">{yen(75000)}</span>
        </p>
        <p class="note">資本金の0.7%が0.35%に軽減。最低税額15万円のケースで7万5千円の軽減。</p>
      </div>
      <div class="ledger-cell">
        <p class="kind">合同会社を設立する場合</p>
        <p class="amounts">
          <span class="was">{yen(60000)}</span><span class="arrow">→</span><span class="now">{yen(30000)}</span>
        </p>
        <p class="note">同じく0.7%→0.35%。最低税額6万円のケースで3万円の軽減。</p>
      </div>
    </div>
  )}

  {s.body.map((b) => (
    <>
      <h2>{b.h}</h2>
      <p>{b.p}</p>
    </>
  ))}

  {s.note && (
    <div class="gaps">
      <h3>注意</h3>
      <ul><li>{s.note}</li></ul>
    </div>
  )}

  <h2>この制度が使える自治体</h2>
  <p>
    本サイトが調査した{municipalities.length}自治体のうち、{citing.length}自治体がこの優遇について案内しています。
    自治体ごとに講座の内容・受講料・開催時期が異なるため、創業予定地のページをご確認ください。
  </p>
  <dl class="local">
    {published.map((m) => (
      <div class="local-row">
        <dt><a href={`/area/${m.prefSlug}/${m.slug}/`}>{m.name}</a></dt>
        <dd>{m.pref}・{m.kind}／対象講座 {m.courses.length}件</dd>
      </div>
    ))}
  </dl>

  <h2>関連ページ</h2>
  <dl class="local">
    <div class="local-row">
      <dt><a href="/compare/fee/">受講料くらべ</a></dt>
      <dd>0円から{yen(stats.max)}まで。同じ証明書が出る講座の受講料を横断比較しています。</dd>
    </div>
    <div class="local-row">
      <dt><a href="/compare/free/">無料で取れる講座</a></dt>
      <dd>受講料をかけずに証明書を取れる講座{stats.free}件。</dd>
    </div>
  </dl>
</Base>
