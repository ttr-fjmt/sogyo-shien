---
import '../styles/tokens.css';
const {
  title,
  description,
  jsonLd = [],
  noindex = false,
  breadcrumbs = [],
  faq = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://sogyo-shien.com');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/ogp-image.png', site);
const isTop = Astro.url.pathname === '/';

// パンくずは各ページから渡す。トップは常に先頭に入れる。
const crumbs = [{ name: 'トップ', url: '/' }, ...breadcrumbs];
const breadcrumbLd =
  crumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(c.url, site).href,
        })),
      }
    : null;

// FAQ は回答エンジンに引用されやすい形にする
const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const siteLd = isTop
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '創業支援ポータル',
      url: site.href,
      inLanguage: 'ja',
      description:
        '市区町村ごとの特定創業支援等事業をまとめ、会社設立時の登録免許税がいくら安くなるかを掲載しています。',
      publisher: { '@type': 'Person', name: '藤本 達郎' },
    }
  : null;

const allLd = [siteLd, breadcrumbLd, faqLd, ...jsonLd].filter(Boolean);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    )}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isTop ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="創業支援ポータル" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />

    {allLd.map((d) => (
      <script type="application/ld+json" set:html={JSON.stringify(d)} />
    ))}

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5761092657360295"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="wrap">
      {crumbs.length > 1 && (
        <nav class="crumbs" aria-label="パンくずリスト">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">›</span>}
              {i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={c.url}>{c.name}</a>}
            </>
          ))}
        </nav>
      )}
      <slot />
      <footer class="site-foot">
        <p><a href="/">トップ</a>　<a href="/about/">このサイトについて</a>　<a href="/privacy/">プライバシーポリシー</a></p>
        <p class="note">掲載内容は各機関の公式ページから取得したものです。申込前に必ず各実施機関へご確認ください。</p>
      </footer>
    </div>
  </body>
</html>
