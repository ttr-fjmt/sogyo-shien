---
import '../styles/tokens.css';
const {
  title,
  description,
  jsonLd = [],
  noindex = false,
  breadcrumbs = [],
  faq = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://sogyo-shien.com');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/ogp-image.png', site);
const isTop = Astro.url.pathname === '/';

// パンくずは各ページから渡す。トップは常に先頭に入れる。
const crumbs = [{ name: 'トップ', url: '/' }, ...breadcrumbs];
const breadcrumbLd =
  crumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(c.url, site).href,
        })),
      }
    : null;

// FAQ は回答エンジンに引用されやすい形にする
const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const siteLd = isTop
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '創業支援ポータル',
      url: site.href,
      inLanguage: 'ja',
      description:
        '市区町村ごとの特定創業支援等事業をまとめ、会社設立時の登録免許税がいくら安くなるかを掲載しています。',
      publisher: { '@type': 'Person', name: '藤本 達郎' },
    }
  : null;

const allLd = [siteLd, breadcrumbLd, faqLd, ...jsonLd].filter(Boolean);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    )}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isTop ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="創業支援ポータル" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />

    {allLd.map((d) => (
      <script type="application/ld+json" set:html={JSON.stringify(d)} />
    ))}


    <!-- 自分のアクセスを計測から外す。?ga=off で除外、?ga=on で解除、?ga=status で現在の状態を表示。
         gtag の読み込みより前に置く必要がある（後ろだと初回のページビューを止められない）。 -->
    <script is:inline>
      (function () {
        var MEASUREMENT_ID = 'G-4N0ZKF117P';
        var KEY = 'analytics-opt-out';
        var mode = null;
        try {
          mode = new URLSearchParams(location.search).get('ga');
          if (mode === 'off') localStorage.setItem(KEY, '1');
          if (mode === 'on') localStorage.removeItem(KEY);
          if (localStorage.getItem(KEY) === '1') window['ga-disable-' + MEASUREMENT_ID] = true;
        } catch (e) {
          // プライベートモード等で localStorage が使えなくても、サイト本体は動かす。
        }
        if (mode !== 'off' && mode !== 'on' && mode !== 'status') return;

        // 効いているかどうかを画面で分かるようにする（操作した本人にだけ出る）。
        var off = false;
        try { off = localStorage.getItem(KEY) === '1'; } catch (e) { off = false; }
        var text = off
          ? 'このブラウザからのアクセスは計測しません（解除するには ?ga=on）'
          : 'このブラウザからのアクセスを計測します（除外するには ?ga=off）';
        document.addEventListener('DOMContentLoaded', function () {
          var el = document.createElement('div');
          el.textContent = text;
          el.style.cssText = 'position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:9999;' +
            'background:#1A2238;color:#FBFAF7;font-size:13px;line-height:1.6;padding:12px 18px;border-radius:4px;' +
            'box-shadow:0 4px 16px rgba(0,0,0,.25);max-width:calc(100vw - 32px);text-align:center';
          document.body.appendChild(el);
          setTimeout(function () { el.remove(); }, 8000);
        });
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4N0ZKF117P"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4N0ZKF117P');
    </script>

    <!-- 外部リンクのクリックを計測する。このサイトの価値は実施機関への送客なので、
         どの自治体からどこへ流れたかが分からないと改善できない。個人情報は送らない。 -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="http"]');
        if (!a) return;
        try {
          var u = new URL(a.href);
          if (u.hostname === location.hostname) return;
          gtag('event', 'outbound_click', {
            link_domain: u.hostname,
            link_url: a.href,
            source_page: location.pathname,
          });
        } catch (_) {}
      }, true);
    </script>

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5761092657360295"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <a class="brand" href="/" aria-label="創業支援ポータル トップページ">
          <span class="brand-mark" aria-hidden="true">創</span>
          <span class="brand-name">創業支援ポータル</span>
        </a>
      </header>
      {crumbs.length > 1 && (
        <nav class="crumbs" aria-label="パンくずリスト">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">›</span>}
              {i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={c.url}>{c.name}</a>}
            </>
          ))}
        </nav>
      )}
      <slot />
      <footer class="site-foot">
        <p class="foot-brand">
          <a class="brand brand-sm" href="/" aria-label="創業支援ポータル トップページ">
            <span class="brand-mark" aria-hidden="true">創</span>
            <span class="brand-name">創業支援ポータル</span>
          </a>
        </p>
        <p><a href="/about/">このサイトについて</a>　<a href="/privacy/">プライバシーポリシー</a></p>
        <p class="note">掲載内容は各機関の公式ページから取得したものです。申込前に必ず各実施機関へご確認ください。</p>
      </footer>
    </div>
  </body>
</html>
